{
  "compilerOptions": {
    "target": "ES2023",
    "module": "none",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "outFile": "build/app.js",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "useDefineForClassFields": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "removeComments": false,
    "sourceMap": true
  },
  "files": [
    "src/types.ts",
    "src/data.ts",
    "src/i18n.ts",
    "src/utils.ts",
    "src/storage.ts",
    "src/engine.ts",
    "src/mock.ts",
    "src/learning-components.ts",
    "src/pedagogy.ts",
    "src/views.ts",
    "src/app.ts"
  ]
}
