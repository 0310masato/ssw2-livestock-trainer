{
  "name": "ssw2-livestock-trainer",
  "version": "0.4.1-alpha-pages-ready",
  "private": true,
  "description": "特定技能2号・畜産農業向けの非公式PWA学習アプリ（社内レビュー用Alpha）",
  "type": "module",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node scripts/build.mjs",
    "validate:content": "python scripts/validate_content.py",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:e2e": "python e2e/smoke.py",
    "verify": "npm run validate:content && npm test && npm run test:e2e",
    "serve": "python -m http.server 4173 -d dist"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
