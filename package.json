{
  "name": "ssw2-livestock-trainer",
  "version": "0.5.0-alpha-pedagogy",
  "private": true,
  "description": "インドネシア人向けに、日本語問題・全文ふりがな・母語解説・重要語・選択肢別解説を備えた特定技能2号畜産PWA教材",
  "type": "module",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node scripts/build.mjs",
    "validate:content": "python scripts/validate_content.py",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:e2e": "python e2e/smoke.py",
    "verify": "npm run validate:content && npm test && npm run test:e2e",
    "serve": "python -m http.server 4173 -d dist"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
